{
  "expo": {
    "name": "DocuTrust",
    "slug": "docutrust",
    "description": "Secure document vault and verification platform",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "docutrust",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3EA",
    "ios": {
      "bundleIdentifier": "app.docutrust.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.docutrust.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EA"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-status-bar",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EA"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "e56016a7-6a77-4f55-8493-ae15a50e072c"
      }
    }
  }
}
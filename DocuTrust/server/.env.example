# DocuTrust server configuration - copy to .env and fill in real values.
# Precedence: system properties > environment variables > this file.

# HTTP port the API listens on
PORT=8080

# Postgres JDBC URL. Local example below; for Supabase use the session pooler form:
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_URL=jdbc:postgresql://localhost:5432/docutrust

DB_USER=postgres
DB_PASSWORD=postgres

# HMAC secret for access tokens: at least 32 characters; the placeholder below is REFUSED at
# startup (E-3). Generate with: openssl rand -base64 48. If the variable is unset, an ephemeral
# secret is generated per boot and tokens will not survive restarts.
JWT_SECRET=change-me-to-a-long-random-string

# AES-256 vault key: 44-char base64 encoding exactly 32 bytes; generate with `openssl rand -base64 32`
# Mandatory once the vault contains files: a non-empty VAULT_DIR with no VAULT_KEY refuses to start.
VAULT_KEY=

# Escape hatch for local dev only: permits an ephemeral key when VAULT_KEY is unset AND the vault is empty.
# Default false; set true only for local dev with an empty vault - the vault will not survive a restart.
ALLOW_EPHEMERAL_VAULT=false

# Where encrypted document objects live
VAULT_DIR=./data/vault

# Seed demo users/documents on an empty database (true|false)
# Localhost-only: SEED_DEMO=true refuses to start unless DB_URL points to localhost/127.0.0.1
# (set SEED_DEMO=false if you use the remote Supabase URL above).
SEED_DEMO=true

# CORS allow-origin header value
CORS_ORIGIN=*

# Where V*.sql migrations live (relative to the server/ working directory)
MIGRATIONS_DIR=../database/migrations

# Optional: logical schema to run in (tests use throwaway schemas; leave unset in production)
# DB_SCHEMA=public

# ---- OTP email delivery (Brevo) -------------------------------------------------
# MAIL_MODE=dev  (default): codes are printed to the server log AND echoed in the
#   X-Dev-OTP response header so demos and the e2e suite work without email traffic.
#   Bodies never contain codes; in dev mode the header is the only side channel.
# MAIL_MODE=live: real email via Brevo's transactional API - requires both variables
#   below; the server refuses to start in live mode without them.
MAIL_MODE=dev
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DocuTrust

# ---- Optional local tracing (Sentry -> Spotlight sidecar) -----------------------
# Set true only while profiling locally with Spotlight (https://spotlightjs.com) running.
SPOTLIGHT_ENABLED=false
